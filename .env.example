# Server only. Without it, the AI assistant uses rule-based answers and receipts are entered manually.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Auth (required for login). Generate with: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Postgres connection string. Required for real accounts in production.
# Migrations run during `npm run build`. Use an isolated DB for smoke tests.
DATABASE_URL=
# Shown on the "Asistență Querra" page (optional; falls back to ADMIN_EMAIL)
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Required for cron: Vercel trimite „Authorization: Bearer $CRON_SECRET” la jobul zilnic de reamintiri
CRON_SECRET=

# Optional private Vercel Blob store. Otherwise files are stored in Postgres.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# Canonical public origin for driver invitation links
# APP_URL=https://your-domain.example

# Native driver pilot: enable only after device acceptance tests. Default is disabled.
MOBILE_DRIVER_ENABLED=0
