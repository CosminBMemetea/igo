# Server only. Without it, the AI assistant uses rule-based answers and receipts are entered manually.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Auth (required for login). Generate with: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Postgres (Neon, AWS Frankfurt eu-central-1): the POOLED connection string. Without it the app runs on in-memory data
# (admins see the banner "Baza de date neconfigurată — datele nu se salvează"). Migrations run during `npm run build`.
DATABASE_URL=
# Shown on the "Asistență Querra" page (optional; falls back to ADMIN_EMAIL)
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Opțional: Vercel trimite „Authorization: Bearer $CRON_SECRET” la jobul zilnic de reamintiri
CRON_SECRET=
