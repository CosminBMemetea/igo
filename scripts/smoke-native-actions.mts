import assert from "node:assert/strict";
import { createActions } from "../apps/driver/src/actions";
const tick = () => new Promise(resolve => setTimeout(resolve, 0));
const deferred = () => { let resolve!: () => void; const promise = new Promise<void>(done => { resolve = done; }); return { promise, resolve }; };
const events: string[] = [], busy: boolean[] = [];
const actions = createActions(() => null, value => busy.push(value));
const network = deferred();
const first = actions.run(async () => { events.push("request"); await network.promise; events.push("ack"); });
await tick();
const privacy = actions.run(async () => { events.push("sync-privacy"); }, async () => { events.push("stop-and-persist"); });
assert.deepEqual(events, ["request", "stop-and-persist"], "privacy is saved before the blocked request finishes");
assert.equal(actions.busy(), true);
await actions.run(async () => { events.push("unexpected-double-click"); });
network.resolve(); await Promise.all([first, privacy]);
assert.deepEqual(events, ["request", "stop-and-persist", "ack", "sync-privacy"]);
assert.equal(actions.busy(), false); assert.equal(busy.at(-1), false);
const refresh = deferred(), starts: string[] = [];
const waiting = createActions(() => refresh.promise, () => {});
const gps = waiting.run(async () => { starts.push("GPS restarted"); });
await tick();
const stop = waiting.run(async () => { starts.push("stop confirmed"); }, async () => { starts.push("GPS off"); });
refresh.resolve(); await Promise.all([gps, stop]);
assert.deepEqual(starts, ["GPS off", "stop confirmed"], "waiting GPS start cannot run after a privacy request");
await assert.rejects(actions.run(async () => { throw Error("must not run"); }, async () => { throw Error("storage unavailable"); }), /storage unavailable/);
assert.equal(actions.busy(), false);
await actions.run(async () => { events.push("recovered"); }); assert.equal(events.at(-1), "recovered");
console.log("PASS native actions: immediate durable privacy during a blocked request, automatic completion, duplicate protection, cancelled waiting GPS start and recovery after storage errors");
