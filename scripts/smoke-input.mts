// smoke:input — validări pure pentru formulare: zecimale stricte, tăiere pe caractere întregi, CSV cu antete RO și rânduri stricate.
import { decNum, clipChars, optNum } from "../src/lib/validate";
import { parseFuelCsv } from "../src/lib/fuel/parse";
let fail = 0;
const ok = (name: string, cond: boolean) => { if (!cond) { fail++; console.error("FAIL", name); } };
ok("1e2 respins", Number.isNaN(decNum("1e2")));
ok("0x10 respins", Number.isNaN(decNum("0x10")) && Number.isNaN(decNum("Infinity")));
ok("virgulă acceptată", decNum("512,40") === 512.4 && decNum(" 100 ") === 100);
ok("optNum -5 în afara intervalului", optNum("-5", 1, 2000) === undefined && optNum("1e2", 1, 2000) === undefined && optNum("", 1, 2000) === null);
const emoji = "⛽".repeat(10) + "🚚".repeat(60), c = clipChars(emoji, 50);
ok("fără surogate orfane", !/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/.test(c));
ok("„…” la tăiere", c.endsWith("…") && Array.from(c).length === 50);
ok("scurt rămâne neschimbat", clipChars("OMV Arad", 50) === "OMV Arad");
const csv = "data,ora,nr auto,litri,suma,moneda\n2026-10-01,10:00,B 01 ABC,100,700,RON\nfoo,bar,baz,qux,1,2\n01.10.2026,x,CJ 12 XYZ,abc,1,RON\n!!!,,,,,\n2026-10-02,11:00,B 02 ABC,50,350,RON\nzzz";
const r = parseFuelCsv(csv);
ok("antete RO mapate", r.delimiter === "," && r.mapping.date === 0 && r.mapping.plate === 2 && r.mapping.litres === 3 && r.mapping.amount === 4 && r.missing.length === 0);
ok("doar rândurile bune", r.rows.length === 2 && !r.confident);
const g = parseFuelCsv("a;b;c\n1;2;3\nx;y;z");
ok("format necunoscut → 0 valide", g.missing.length > 0 && g.rows.length === 0);
console.log(fail ? `smoke:input: ${fail} eșec(uri)` : "smoke:input OK");
process.exit(fail ? 1 : 0);
