// Run against an explicitly disposable local dev server with DATABASE_URL='' and SESSION_SECRET set.
// Creates fictitious records only; restart that server after testing to discard them.
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { csv, PROFILE_HEADERS } from "../src/lib/compliance-csv";
const base=process.env.COMPLIANCE_TEST_URL;
if (!base || !["localhost","127.0.0.1"].includes(new URL(base).hostname)) throw new Error("COMPLIANCE_TEST_URL must be a disposable local server");
assert.equal((await (await fetch(base+"/api/health")).json()).db,"not-configured","Never run this fixture against a real database");
const form=(data:Record<string,string>)=>{const f=new FormData();Object.entries(data).forEach(([k,v])=>f.set(k,v));return f;};
const withLoc=(c:string)=>c.includes("igo-locale=")?c:(c?`${c}; igo-locale=ro`:"igo-locale=ro");
const req=(path:string,cookie="",body?:FormData|object)=>fetch(base+path,{redirect:"manual",method:body ? "POST":"GET",headers:{cookie:withLoc(cookie),accept:"application/json",...(body && !(body instanceof FormData) ? {"content-type":"application/json"}:{})},body:body instanceof FormData ? body : body ? JSON.stringify(body):undefined});
const cookieOf=(r:Response)=>r.headers.getSetCookie().find(c=>c.startsWith("igo-session="))?.split(";")[0] ?? "";
const logins:{email:string;password:string}[]=[];
const signup=async()=>{const credentials={email:`${randomUUID()}@example.test`,password:randomUUID()};logins.push(credentials);const r=await req("/api/auth/signup","",form({firm:"Compliance HTTP QA",...credentials}));assert.equal(r.status,303);const c=cookieOf(r);assert.ok(c);return c;};
const owner=await signup(), other=await signup();
assert.equal((await req("/api/docs/export")).status,401);
assert.equal((await req("/api/setup/truck",owner,form({plate:"BH 21 QRT",model:"QA",category:"N1",mtmaKg:"18000"}))).status,400);
const add=await req("/api/setup/truck",owner,form({plate:"BH 21 QRT",model:"QA",category:"N3",mtmaKg:"18000",country:"RO",euro:"6",propulsion:"diesel",seats:"2"}));assert.equal(add.status,200);
const truckPage=await (await req("/trucks",owner)).text();const truck=truckPage.match(/name="id" value="(t_[a-z0-9]+)"/)?.[1];assert.ok(truck);
const doc=await req("/api/docs",owner,form({scope:"vehicle",target:truck,type:"rca",expires:"2027-10-01",validFrom:"2026-10-01"}));assert.equal(doc.status,303);assert.ok(!doc.headers.get("location")?.includes("e="));
const invalid=await req("/api/docs",owner,form({scope:"vehicle",target:truck,type:"itp",expires:"2026-10-01",validFrom:"2027-10-01"}));assert.ok(invalid.headers.get("location")?.includes("e=date"));
const badAttachment=form({scope:"vehicle",target:truck,type:"casco",expires:"2027-10-01",note:"INVALID-ATTACHMENT-MUST-NOT-SAVE"});
badAttachment.set("file",new Blob(["not a pdf"],{type:"application/pdf"}),"invalid.pdf");
assert.ok((await req("/api/docs",owner,badAttachment)).headers.get("location")?.includes("e=file-type"));
assert.ok(!(await (await req("/documents?tab=vehicles",owner)).text()).includes("INVALID-ATTACHMENT-MUST-NOT-SAVE"));
const report=await (await req("/api/docs/export",owner)).text();assert.ok(report.includes('"tollro"'));assert.ok(report.includes('"missing"'));assert.ok(report.includes("declared_not_officially_verified"));
assert.ok(!(await (await req("/api/docs/export",other)).text()).includes("BH 21 QRT"));
console.log("PASS HTTP classification validation, document period, report and tenant isolation");
const data=csv([Array.from(PROFILE_HEADERS),["BH 21 QRT","N3",18000,2,5,"diesel","RO"]]);
assert.equal((await req("/api/docs/vehicle-import",owner,{csv:'"unclosed',mode:"preview"})).status,400);
const preview=await (await req("/api/docs/vehicle-import",owner,{csv:data,mode:"preview"})).json();assert.ok(preview.stamp);
assert.equal((await req("/api/docs/vehicle-import",other,{csv:data,mode:"commit",stamp:preview.stamp})).status,400);
assert.equal((await req("/api/docs/vehicle-import",owner,{csv:data,mode:"commit",stamp:"incorrect"})).status,409);
assert.equal((await req("/api/docs/vehicle-import",owner,{csv:data,mode:"commit",stamp:preview.stamp})).status,200);
assert.equal((await req("/api/docs/vehicle-import",owner,{csv:data,mode:"commit",stamp:preview.stamp})).status,409);
console.log("PASS HTTP CSV preview/commit, stale preview rejected");
const phone="+407"+String(Date.now()).slice(-8);
assert.equal((await req("/api/setup/invite",owner,form({name:"QA Driver",phone,locale:"ro",ret:"/drivers"}))).status,200);
const driverPage=await (await req("/drivers",owner)).text(), token=driverPage.match(/\/join\?t=([A-Za-z0-9_.%-]+)/)?.[1];assert.ok(token);
const join=await req("/api/auth/join","",form({t:decodeURIComponent(token),phone,pin:"483927",pin2:"483927"}));const driver=cookieOf(join);assert.ok(driver);
assert.equal((await req("/api/docs/vehicle-import",driver,{csv:data,mode:"preview"})).status,403);
const uid=JSON.parse(Buffer.from(driver.split("=")[1].split(".")[0],"base64url").toString()).uid;
assert.equal((await req("/api/drivers/assign",owner,form({uid,truck}))).status,200);
// Another vehicle's note must not be serialized into any driver client props.
await req("/api/setup/truck",owner,form({plate:"BH 22 QRT",model:"QA"}));
const trucksHtml=await (await req("/trucks",owner)).text();
const second=[...trucksHtml.matchAll(/name="id" value="(t_[a-z0-9]+)"/g)].map(m=>m[1]).find(id=>id!==truck);assert.ok(second);
await req("/api/docs",owner,form({scope:"vehicle",target:second,type:"itp",expires:"2027-10-01",note:"PRIVATE-OTHER-VEHICLE-NOTE"}));
assert.ok(!(await (await req("/driver",driver)).text()).includes("PRIVATE-OTHER-VEHICLE-NOTE"));
const {PDFDocument}=await import("pdf-lib"), pdf=await PDFDocument.create();pdf.addPage();
const attachment=form({scope:"vehicle",target:truck,type:"itp",expires:"2027-10-01"});
attachment.set("file",new Blob([new Uint8Array(await pdf.save())],{type:"application/pdf"}),"itp.pdf");
assert.ok(!(await req("/api/docs",owner,attachment)).headers.get("location")?.includes("e="));
const filePage=await (await req("/driver",driver)).text(), file=filePage.match(/\/api\/files\/(fl_[a-z0-9-]+)/)?.[1];assert.ok(file);
const download=await req(`/api/files/${file}`,driver);assert.equal(download.status,200);assert.equal(download.headers.get("cache-control"),"private, no-store");
assert.equal((await req(`/api/files/${file}`,other)).status,404);
console.log("PASS HTTP attachment validation before save, driver response isolation and assigned document access");
const createTask=()=>req("/api/docs/tasks",owner,form({truckId:truck,type:"itp",due:"2026-10-18"}));
assert.equal((await createTask()).status,200);assert.equal((await createTask()).status,200);
assert.equal((await req("/api/docs/tasks",owner,form({truckId:truck,type:"itp",due:"2026-10-19"}))).status,409);
const tasksPage=await (await req("/documents",owner)).text(), task=tasksPage.match(/name="id" value="(ct_[a-z0-9]+)"/)?.[1];assert.ok(task);
assert.equal((await req("/api/docs/tasks",driver,form({id:task,status:"done"}))).status,403);
assert.equal((await req("/api/docs/tasks",other,form({id:task,status:"done"}))).status,409);
assert.equal((await req("/api/docs/export",driver)).status,403);
assert.equal((await req("/api/driver/compliance-task",driver,form({id:task}))).status,200);
assert.ok((await (await req("/driver",driver)).text()).includes("Preluată de șofer"));
assert.ok((await (await req("/notifications",driver)).text()).includes("Verificare solicitată"));
assert.equal((await req("/api/drivers/assign",owner,form({uid,truck:""}))).status,200);
assert.equal((await req("/api/driver/compliance-task",driver,form({id:task}))).status,409);
assert.equal((await req(`/api/files/${file}`,driver)).status,403);
assert.ok(!(await (await req("/notifications",driver)).text()).includes("Verificare solicitată"));
assert.equal((await req("/api/docs/tasks",owner,form({id:task,status:"done"}))).status,200);
console.log("PASS HTTP owner/driver tasks, acknowledgement, authorization, stale notifications after reassignment");
if(process.env.COMPLIANCE_UI_FIXTURE){
  const {writeFile}=await import("node:fs/promises");
  await req("/api/drivers/assign",owner,form({uid,truck}));await createTask();
  await writeFile(process.env.COMPLIANCE_UI_FIXTURE,JSON.stringify({base,owner:logins[0],driver:{phone,pin:"483927"}}),{mode:0o600});
}
console.log("Compliance HTTP: all PASS (ephemeral fixtures remain until local server restart)");
