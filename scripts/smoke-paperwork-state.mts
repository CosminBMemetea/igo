import assert from "node:assert/strict";
import { projectPaperwork, mergePaperFiles, type PaperworkState } from "../src/lib/paperwork-state";
import { uploadPaperworkPhotos } from "../src/lib/paperwork-upload";
import type { OutboxItem } from "../src/lib/outbox";
const initial: PaperworkState = {loadedAt:null,unloadedAt:null,waitMin:0,waitSince:null,files:[]};
const at=(minute:number)=>`2026-10-19T10:${String(minute).padStart(2,"0")}:00.000Z`;
const event=(id:string,kind:string,minute:number,status:"pending"|"blocked"="pending"):OutboxItem=>({id,scope:"scope",actorId:"driver",kind:"event",label:kind,created:minute,status,payload:{tripId:"trip",kind,occurredAt:at(minute)}});
const sequence=[event("load","loaded",0),event("start","wait_start",1),event("end","wait_end",11),event("unload","unloaded",12)];
let result=projectPaperwork(initial,"trip",sequence);
assert.equal(result.state.waitMin,10);assert.equal(result.state.unloadedAt,at(12));assert.equal(initial.loadedAt,null);
result=projectPaperwork(initial,"trip",sequence.map((e,i)=>i===0?{...e,status:"blocked"}:e));
assert.equal(result.state.loadedAt,null);assert.equal(result.state.unloadedAt,null);assert.equal(result.state.waitMin,0);assert.equal(result.blocked,true);
const accepted=sequence.map(e=>({id:e.id,tripId:"trip",kind:(e.payload as any).kind,at:(e.payload as any).occurredAt}));
result=projectPaperwork(initial,"trip",[],accepted);assert.equal(result.state.unloadedAt,at(12));assert.equal(result.state.waitMin,10);assert.equal(result.pending,false);
result=projectPaperwork({...initial,loadedAt:at(0),lastEventAt:at(0)},"trip",sequence,accepted);assert.equal(result.state.waitMin,10,"ACK plus still-visible IndexedDB entry must not double count waiting");
result=projectPaperwork({...initial,loadedAt:at(0),waitMin:10,lastEventAt:at(11)},"trip",[],accepted);assert.equal(result.state.waitMin,10);assert.equal(result.state.unloadedAt,at(12));
assert.equal(projectPaperwork(initial,"other-trip",sequence,accepted).state.loadedAt,null);
assert.equal(projectPaperwork({...initial,unloadedAt:at(12)},"trip",[event("stale","wait_start",15)]).state.waitSince,null);
const file={id:"one",kind:"cmr" as const,src:"/api/files/one",name:"one.jpg"};
assert.equal(mergePaperFiles([file],[file]).length,1);
let calls=0;
const uploads=await uploadPaperworkPhotos(Array.from({length:10},(_,i)=>({name:`photo${i}`})),async f=>{calls++;if(f.name==="photo1")throw Error("too large");if(f.name==="photo4")throw Error("offline");return {...file,id:f.name};});
assert.equal(calls,8);assert.equal(uploads.added.length,6);assert.deepEqual(uploads.failed.map(f=>f.name),["photo1","photo4"]);assert.equal(uploads.skipped,2);
console.log("PASS paperwork: rejected event and dependants never complete; ACK retained across queue removal; server catch-up does not double-count; no trip cross-talk; deduped photos; partial failure/8-photo limit reported");
