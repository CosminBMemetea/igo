import assert from "node:assert/strict";
import { randomUUID,createECDH,randomBytes } from "node:crypto";
import {writeFile} from "node:fs/promises";
const base=process.env.NOTIFICATIONS_TEST_URL;
if(!base || !["localhost","127.0.0.1"].includes(new URL(base).hostname))throw Error("Set NOTIFICATIONS_TEST_URL to an explicitly disposable local server");
assert.equal((await (await fetch(base+"/api/health",{signal:AbortSignal.timeout(60000)})).json()).db,"not-configured");
const form=(v:Record<string,string>)=>{const f=new FormData();for(const[k,x]of Object.entries(v))f.set(k,x);return f};
const send=(p:string,cookie="",b?:object|FormData,origin=base,headers:Record<string,string>={})=>fetch(base+p,{method:b?"POST":"GET",redirect:"manual",signal:AbortSignal.timeout(60000),headers:{cookie,accept:"application/json",...(b?{origin,...(b instanceof FormData?{}:{"content-type":"application/json"})}:{}),...headers},body:b instanceof FormData?b:b?JSON.stringify(b):undefined});
const cookie=(r:Response,name:string)=>r.headers.getSetCookie().find(c=>c.startsWith(name+"="))?.split(";")[0]??"";
const ownerCred={email:`qa-${randomUUID()}@example.test`,password:randomUUID()};
const r=await send("/api/auth/signup","",form({firm:"Push/email QA",...ownerCred}));assert.equal(r.status,303);
const owner=cookie(r,"igo-session");assert.ok(owner);
assert.equal((await send("/api/notifications/push")).status,401);
let s=await send("/api/notifications/settings",owner);assert.equal(s.status,200);assert.match(s.headers.get("cache-control")!,/no-store/);assert.equal((await s.json()).email,ownerCred.email);
assert.equal((await send("/api/notifications/settings",owner,{email:ownerCred.email,enabled:false},"https://evil.test")).status,403);
assert.equal((await send("/api/notifications/settings",owner,{email:ownerCred.email,enabled:false})).status,200);
assert.equal((await (await send("/api/notifications/settings",owner)).json()).enabled,false);
assert.equal((await send("/api/notifications/settings",owner,{email:"invalid",enabled:true,password:ownerCred.password})).status,400);
assert.equal((await send("/api/notifications/settings",owner,{email:"new@example.test",enabled:true,password:"wrong"})).status,400);
assert.equal((await send("/api/notifications/settings",owner,{email:ownerCred.email,enabled:true})).status,200);
console.log("PASS HTTP owner preferences, stale/anonymous session, CSRF, email validation and password gate");
const ec=createECDH("prime256v1");ec.generateKeys();const sub={endpoint:"https://web.push.apple.com/qa-"+randomUUID(),keys:{p256dh:ec.getPublicKey().toString("base64url"),auth:randomBytes(16).toString("base64url")}};
assert.equal((await send("/api/notifications/push",owner,{action:"on",subscription:{...sub,endpoint:"http://127.0.0.1:80/"}})).status,400);
assert.equal((await send("/api/notifications/push",owner,{action:"on",subscription:{...sub,keys:{...sub.keys,p256dh:"bad"}}})).status,400);
assert.equal((await send("/api/notifications/push",owner,{action:"on",extra:"A".repeat(7000)})).status,400);
const enrolled=await send("/api/notifications/push",owner,{action:"on",subscription:sub});assert.equal(enrolled.status,200);const binding=cookie(enrolled,"qfleet-push-device");assert.ok(binding);const registered=owner+"; "+binding;
assert.equal((await (await send("/api/notifications/push",registered)).json()).active,true);
assert.equal((await send("/api/notifications/push",registered,{action:"on",subscription:sub})).status,200);
const secondDevice=await send("/api/notifications/push",owner,{action:"on",subscription:{...sub,endpoint:sub.endpoint+"-second"}});assert.equal(secondDevice.status,200);
assert.equal((await(await send("/api/notifications/push",registered)).json()).devices,2);
assert.equal((await send("/api/notifications/push",registered,{action:"off-all"})).status,200);
assert.equal((await(await send("/api/notifications/push",registered)).json()).devices,0);
assert.equal((await send("/api/notifications/push",registered,{action:"on",subscription:sub})).status,200);
assert.equal((await send("/api/auth/logout",registered,form({}))).status,303);
assert.equal((await (await send("/api/notifications/push",registered)).json()).active,false);
console.log("PASS HTTP push validation, subscribe/idempotent registration and logout revocation (no real push sent)");
const phone="+407"+String(Date.now()).slice(-8);
assert.equal((await send("/api/setup/invite",owner,form({name:"QA Push Driver",phone,locale:"ro",ret:"/drivers"}))).status,200);
const html=await(await send("/drivers",owner)).text(),tk=html.match(/\/join\?t=([A-Za-z0-9_.%-]+)/)?.[1];assert.ok(tk);
const joined=await send("/api/auth/join","",form({t:decodeURIComponent(tk),phone,pin:"483927",pin2:"483927"})),driver=cookie(joined,"igo-session");assert.ok(driver);
assert.equal((await(await send("/api/notifications/settings",driver)).json()).email,"");
const driverEmail=`driver-${randomUUID()}@example.test`;
assert.equal((await send("/api/notifications/settings",driver,{email:driverEmail,enabled:true,password:"483927"})).status,200);
assert.equal((await(await send("/api/notifications/settings",driver)).json()).email,driverEmail);
assert.equal((await(await send("/api/notifications/settings",owner)).json()).email,ownerCred.email);
assert.ok((await(await send("/notifications",driver)).text()).includes("NotificationSettings"));
const driverPush=await send("/api/notifications/push",driver,{action:"on",subscription:sub});assert.equal(driverPush.status,200);const dc=driver+"; "+cookie(driverPush,"qfleet-push-device");
assert.equal((await(await send("/api/notifications/push",dc)).json()).active,true);
assert.equal((await(await send("/api/notifications/push",registered)).json()).active,false);
const logged=await send("/api/auth/login",dc,form(ownerCred));assert.equal(logged.status,303);
assert.equal((await(await send("/api/notifications/push",dc)).json()).active,false);
console.log("PASS HTTP driver email setup with PIN, owner/driver isolation and account-switch revocation");
const cr=await send("/api/cron/reminders","",undefined,base,{authorization:"Bearer qfleet-notifications-qa-cron"});assert.equal(cr.status,200);assert.equal((await cr.json()).skipped,"no database");
assert.equal((await send("/api/cron/reminders","",undefined,base,{authorization:"Bearer bad"})).status,401);
assert.equal((await send("/api/cron/deliveries","",undefined,base,{authorization:"Bearer qfleet-notifications-qa-cron"})).status,503);
console.log("PASS HTTP cron bearer is not confused with mobile auth; missing/wrong credentials rejected");
const mobile=await send("/api/auth/mobile","",{login:phone,password:"483927"});assert.equal(mobile.status,200);const login=await mobile.json();assert.ok(login.token);
assert.equal((await send("/api/driver/push","",undefined,base,{authorization:`Bearer ${login.token}`})).status,200);
assert.equal((await send("/api/driver/push","",{action:"on",token:"a".repeat(64)},base,{authorization:`Bearer ${login.token}`})).status,503);
assert.equal((await send("/api/driver/push","",{action:"status",token:"a".repeat(64)},base,{authorization:`Bearer ${login.token}`})).status,200);
assert.equal((await send("/api/driver/push",driver)).status,401);
assert.equal((await send("/api/notifications/settings","",undefined,base,{authorization:`Bearer ${login.token}`})).status,403);
console.log("PASS HTTP native push scoped bearer, missing APNs configuration honest, web/native separation");
if(process.env.NOTIFICATIONS_UI_FIXTURE)await writeFile(process.env.NOTIFICATIONS_UI_FIXTURE,JSON.stringify({base,owner:ownerCred,driver:{phone,pin:"483927"},driverEmail}),{mode:0o600});
console.log("Notification HTTP: all PASS. Fixtures are fictitious and disappear when local server stops.");
