import assert from "node:assert/strict";
import { driverActivity, driverProgress } from "../src/lib/driver-progress";
import { groupDriverTrips, driverTripSummary } from "../src/lib/driver-trips";
import { tripFocus, invitationPhone, type Board } from "../apps/driver/src/board";
import { decide } from "../src/lib/access";
import { mobileRoute } from "../src/lib/mobile-session";
import { inviteToken, readInvite, INVITE_TTL_S } from "../src/lib/invite";
import type { TripRow, UserRow } from "../src/lib/store/types";
import { MemStore } from "../src/lib/store/mem";
const today = "2026-10-19", at = "2026-10-19T08:00:00Z";
const user = (id: string): UserRow => ({ id, firmId: "firm", role: "driver", name: id, phone: null, email: null, passwordHash: "hash", truckId: "truck" });
const users = [user("a"), user("b"), user("c"), { ...user("off"), disabledAt: at }];
const trip = (id: string, driverId: string, patch: Partial<TripRow> = {}): TripRow => ({ id, firmId: "firm", truckId: "truck", driverId, client: "QA", title: "Oradea → Viena", date: today, km: 500, revenue: 99999, litres: 150, fuelPrice: 7, tolls: 40, driverCost: 50, other: 0, planned: false, deliveredAt: at, podReceived: true, ...patch });
const trips = [trip("1", "a"), trip("2", "a", { truckId: "previous-truck" }), trip("3", "b"), trip("4", "b"), trip("5", "c"), trip("cancel", "a", { cancelledAt: at }), trip("no-pod", "a", { podReceived: false }), trip("future", "a", { deliveredAt: "2026-10-20T08:00:00Z" }), trip("old", "a", { deliveredAt: "2026-09-19T08:00:00Z" }), trip("foreign", "a", { firmId: "foreign" }), trip("unassigned", "", {}), trip("missing-date", "a", { deliveredAt: null })];
const activity = driverActivity(users, trips, today);
assert.deepEqual(activity.rows.map(r => [r.id, r.completed, r.rank]), [["a", 2, 1], ["b", 2, 1], ["c", 1, 3]]);
const progress = driverProgress(users, trips, "a", today);
assert.equal(progress.lifetime, 3); assert.equal(progress.completed, 2); assert.equal(progress.next?.count, 5);
assert.equal(progress.badges.length, 1); assert.equal(JSON.stringify(progress).includes("99999"), false);
assert.equal(driverProgress(users.slice(0, 2), trips, "a", today).rank, null);
assert.equal(driverProgress(users, [], "a", today).rank, null);
console.log("PASS progress: driver attribution survives truck changes, POD required, cancelled/future/foreign/unassigned excluded, ties honest, no fabricated ranking or money");
const board = (trips: TripRow[]): Board => ({ name: "A", firm: "Firm", truck: { id: "truck", plate: "BH 01 QA" }, shift: null, trips: groupDriverTrips(trips.map(driverTripSummary), today), serverTime: at });
assert.equal(tripFocus(board([])).hasWork, false);
assert.equal(tripFocus(board([trip("done", "a")])).hasWork, false);
assert.equal(tripFocus(board([trip("next", "a", { planned: true, deliveredAt: null, date: "2026-10-20" })])).hasWork, false);
const load = trip("load", "a", { planned: true, deliveredAt: null, loadedAt: at, podReceived: false });
assert.equal(tripFocus(board([load])).current?.id, "load");
assert.equal(tripFocus(board([{ ...load, deliveredAt: at }])).current, undefined);
assert.equal(tripFocus(board([{ ...load, truckId: "another-truck" }])).hasWork, false);
assert.equal(tripFocus(board([{ ...load, cancelledAt: at }])).current, undefined);
console.log("PASS trips: empty/future/finished/cancelled cannot become a current trip; another truck cannot enable the shift checklist");
assert.equal(invitationPhone("qfleet-driver-test://login?phone=%2B40744123456"), "+40744123456");
assert.equal(invitationPhone("https://evil.test/login?phone=0744123456"), null);
assert.equal(invitationPhone("qfleet-driver-test://login?phone=not-a-phone"), null);
const secret = "qa-secret-".repeat(6), now = Math.floor(Date.now() / 1000), token = await inviteToken("firm", "invite", secret, now);
assert.equal((await readInvite(token, secret, now))?.inv, "invite");
assert.equal(await readInvite(token, secret, now + INVITE_TTL_S + 1), null);
assert.equal(await readInvite(token + "x", secret, now), null);
assert.equal(decide("/join/ready", { role: "driver", firm: "firm", uid: "a", email: "a", exp: now + 100 }).kind, "allow");
assert.equal(decide("/join/ready", null).kind, "login");
assert.equal(mobileRoute("/api/trips/event", "POST"), true);
assert.equal(mobileRoute("/api/trips/complete", "POST"), false);
console.log("PASS invite: scoped deep link only prefills phone; signed expiry/tamper checks; activation result requires session; native financial endpoints remain blocked");
const memory = new MemStore(), invitation = await memory.createInvite("firm", "QA", "+40744000001");
let previous = Math.floor(Date.parse(invitation.createdAt) / 1000);
for (let i = 0; i < 3; i++) {
  assert.equal(await memory.renewInvite("firm", invitation.id), true);
  const next = Math.floor(Date.parse((await memory.invite("firm", invitation.id))!.createdAt) / 1000);
  assert.ok(next > previous, "Immediate renewals must never revive a previous QR link"); previous = next;
}
assert.equal(await memory.renewInvite("foreign", invitation.id), false);
console.log("PASS invite renewal: successive links have distinct validity timestamps, foreign firm denied");
