 await s.setUserTruck(f.id,driver.id,truck.id);
 const doc=await s.addDoc(f.id,{truckId:truck.id,type:"rca",expires});
 const context:DeliveryContext={kind:"document",userId:driver.id,docId:doc.id,expires,stage:"d7"};
 let calls=0;const accepted=new Map<string,string>(),ids:string[]=[];
 const good={name:"fake",send:async(_m:unknown,id?:string)=>{calls++;ids.push(id!);accepted.set(id!,"accepted");return{id:"accepted"}}};
 const providers={email:good,push:{send:async()=>({id:"push-accepted"})}};
 const add=async(p:Partial<Parameters<Store['addEmail']>[0]>={})=>(await s.addEmail({firmId:f.id,key:randomUUID(),to:driver.email!,subject:"QA",body:"QA",context,...p}))!;
 const get=async(r:EmailRow)=>(await s.emails(2000)).find(e=>e.id===r.id)!;
 const drain=(row:EmailRow,opts:Record<string,unknown>={})=>drainDeliveries(s,{id:row.id,now,today,providers,...opts});
 let row=await add();assert.equal(await s.addEmail({firmId:f.id,key:row.key,to:driver.email!,subject:"same",body:"same"}),null);
 await Promise.all(Array.from({length:12},()=>drain(row)));assert.equal(calls,1);assert.equal((await get(row)).status,"sent");await drain(row);assert.equal(calls,1);
 pass(`${label}: concurrent workers, unique key, sent rows never replay`);
