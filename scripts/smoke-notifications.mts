 pass(`${label}: driver task mail, owner acknowledgement alert, old task state suppressed`);
 for(let i=0;i<20;i++) {
   const immediate=await s.addEmail({firmId:f.id,key:randomUUID(),to:u.email!,subject:"Immediate",body:"QA"});
