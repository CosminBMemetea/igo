 row=await add();const failing={email:{name:"fake",send:async()=>{throw new DeliveryError("email-http-429",true,180000)}},push:null};
 await drain(row,{providers:failing});let state=await get(row);assert.equal(state.status,"queued");assert.ok(Date.parse(state.nextAttemptAt)>=now+180000);await drain(row);assert.equal((await get(row)).attempts,1);
 await drain(row,{now:Date.parse(state.nextAttemptAt)});assert.equal((await get(row)).status,"sent");assert.equal((await get(row)).attempts,2);
 pass(`${label}: rate limit backoff, no early retry, eventual acceptance`);
 row=await add();await drain(row,{providers:{email:{name:"bad",send:async()=>{throw new DeliveryError("email-http-422",false)}},push:null}});assert.equal((await get(row)).status,"failed");
 pass(`${label}: permanent rejection terminal`);
 row=await add();let cursor=now;
 for(let i=0;i<MAX_ATTEMPTS;i++){await drain(row,{now:cursor,providers:{email:{name:"bad",send:async()=>{throw Error("network secret should not be persisted")}},push:null}});cursor=Date.parse((await get(row)).nextAttemptAt);}
 assert.equal((await get(row)).status,"failed");assert.equal((await get(row)).attempts,MAX_ATTEMPTS);assert.equal((await get(row)).error,"delivery-temporary-error");
 pass(`${label}: capped retries and redacted failure details`);
 row=await add();const first=await s.claimDelivery(["email"],new Date(now).toISOString(),row.id);assert.ok(first);
 const second=await s.claimDelivery(["email"],new Date(now+91000).toISOString(),row.id);assert.ok(second);assert.notEqual(first.leaseToken,second.leaseToken);
 assert.equal(await s.finishDelivery(row.id,first.leaseToken!,{status:"sent",error:null}),false);
 await s.finishDelivery(row.id,second.leaseToken!,{status:"queued",error:null});await drain(row,{now:now+92000});assert.equal((await get(row)).status,"sent");
 pass(`${label}: abandoned lease reclaimed, stale worker fenced`);
 row=await add();await s.claimDelivery(["email"],new Date(now).toISOString(),row.id);await drain(row,{now:now+24*3600000});assert.equal((await get(row)).status,"failed");
