 pass(`${label}: shared browser rebinding and logout revoke previous account deliveries`);
 const native=await s.savePushDevice({firmId:f.id,userId:driver.id,sessionVersion:current.sessionVersion??0,binding:"native",endpoint:"apns:"+"a".repeat(64),p256dh:"",auth:"",transport:"apns",validUntil:new Date(now-1).toISOString()});
 row=await add({channel:"push",subscriptionId:native.id,to:""});await drain(row);assert.equal((await get(row)).status,"cancelled");
 pass(`${label}: native push stops when signed mobile session expires`);
 const task=await s.addComplianceTask(f.id,{truckId:truck.id,driverId:driver.id,type:"itp",due:today});assert.ok(task);
