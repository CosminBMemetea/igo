{
  "name": "qfleet-driver",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:check": "node scripts/build-android.mjs check",
    "android:build:preview": "node scripts/build-android.mjs preview",
    "ios": "expo run:ios",
    "ios:check": "node scripts/build-ios.mjs check",
    "ios:build:simulator": "node scripts/build-ios.mjs simulator",
    "ios:build:device": "node scripts/build-ios.mjs device",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "expo": "58.0.14",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.2"
  },
